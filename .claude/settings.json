{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write",
      "Bash(awk '{print $9}')",
      "Bash(mkdir -p /Users/dobrek/Projects/10xdev3/context/changes/*)"
    ],
    "deny": ["Bash(rm -rf *)"],
    "ask": ["Bash(curl *)", "Bash(wget *)", "Bash(git push *)", "Bash(git push)"],
    "additionalDirectories": ["/Users/dobrek/Projects/10xdev3/context/changes"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; [ -n \"$f\" ] && pnpm exec prettier --write --ignore-unknown --log-level=silent \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  }
}
