# Editor defaults, mainly for the files Prettier does not format: Python, TOML, YAML, shell, SQL.
# Prettier reads this file too; the values below match .prettierrc.json, which wins where both speak.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# services/solver: ruff's line length (pyproject.toml).
[*.py]
indent_size = 4
max_line_length = 110

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
