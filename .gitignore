# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.envs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# from 10x-astro-starter
# build output
dist/

# generated types
.astro/

# logs
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# jetbrains setting folder
.idea/

node_modules/

# lefthook local overrides
lefthook-local.yml

# pii scrub artifacts (contain real names — never commit)
/pii-scrub/

# gold-plan snapshots dumped from production (real names + real timetable — never commit)
/data/golden-plan*.sql

# playwright
.playwright-mcp
.playwright-cli
e2e/.auth/
test-results/
playwright-report/
.playwright/

# services/solver — Python CP-SAT solver service (local tooling)
# Golden-catalog dumps are production-derived and must NEVER be committable; a `.json` golden
# dump is NOT caught by the `.sql`-only golden-plan pattern above. Python tooling droppings are
# ignored so `git status` stays clean. The committed seed fixture lives under
# services/solver/tests/fixtures/, outside every ignored path below.
/services/solver/data/
/services/solver/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/