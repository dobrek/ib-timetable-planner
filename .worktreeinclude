# Gitignored files to copy into a new worktree (Claude Code / Conductor).
# Only ignored files matching a pattern are copied; tracked files are never duplicated.
# Syntax is .gitignore. Installs stay out of this file: run `pnpm install` and
# `uv sync` in the worktree instead of copying node_modules or services/solver/.venv.

# Profile sources (per-machine). `pnpm env:local` / `env:prod` / `env:prod-solver`
# copy one of these onto .env.local and .dev.vars.
.envs/

# Active dotenv files so `pnpm dev`, `pnpm preview`, and wrangler work without
# re-running an env:* script first. `.env*` also covers .env.test.local (integration
# tests + scripts/assign-role.mjs) and .env.example.
.env*
.dev.vars*

# Intentionally not listed:
#   node_modules/, services/solver/.venv/  — reinstall
#   dist/, .astro/, .wrangler/             — generated
#   services/solver/data/, data/golden-plan*.sql, pii-scrub/, .campaign/
#                                          — production-derived / secret bulk
#   e2e/.auth/, .playwright*/, test-results/, playwright-report/
#                                          — regenerated by pretest:e2e / the runner
