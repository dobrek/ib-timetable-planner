    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "steiger": "^0.5.13",
    "supabase": "^2.107.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite-tsconfig-paths": "^6.1.1",
