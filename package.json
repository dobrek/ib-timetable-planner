    "env:local": "cp .envs/local.vars .env.local && cp .envs/local.vars .dev.vars",
    "env:prod": "cp .envs/prod.vars .env.local && cp .envs/prod.vars .dev.vars"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
