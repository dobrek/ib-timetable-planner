---
import Banner from "@/shared/ui/Banner.astro";
import type { PendingKind } from "../model/pending-account";
import AccountSettings from "./AccountSettings";

type Props = {
  email: string;
  displayName: string | null;
  /**
   * Why the account is fenced until the person chooses a password (S-409, S-410), or `null` once it
   * is not. Driven by the access the middleware read, not by a query string, so it shows however
   * they arrived, and the middleware sends every other page here.
   */
  pendingKind: PendingKind | null;
  /** `?saved=name` or `?saved=password` after a save: the reload destroys the form's toast, so the page reports it. */
  saved: string | null;
  /** `?notice=recovery` when a password-reset link signed the user in (S-402's `/api/auth/confirm`). */
  notice: string | null;
};

const { email, displayName, pendingKind, saved, notice } = Astro.props;

// One banner at a time: a pending person who arrived by a reset link still reads why they are here.
const PENDING_MESSAGES: Record<PendingKind, string> = {
  invitation: "Welcome to IB Planner. Choose a password below to start using the planner.",
  temporary_password:
    "An administrator gave you a temporary password. Choose your own below to start using the planner.",
};

// One status line for every save on this page, so each form confirms the same, prominent way.
const SAVED_MESSAGES: Partial<Record<string, string>> = {
  name: "Display name saved.",
  password: "Password changed.",
};
// Own keys only: `?saved=valueOf` would otherwise reach Object.prototype and break the render.
const savedMessage = saved && Object.hasOwn(SAVED_MESSAGES, saved) ? SAVED_MESSAGES[saved] : undefined;
---

<div class="max-w-xl space-y-6">
  {
    pendingKind && (
      <div class="overflow-hidden rounded-lg">
        <Banner variant="info">{PENDING_MESSAGES[pendingKind]}</Banner>
      </div>
    )
  }

  {
    !pendingKind && notice === "recovery" && (
      <div class="overflow-hidden rounded-lg">
        <Banner variant="info">You're signed in from a password-reset link. Choose a new password below.</Banner>
      </div>
    )
  }

  <header>
    <h1 class="text-foreground text-2xl font-semibold tracking-tight">Account</h1>
    <p class="text-muted-foreground mt-1 text-sm">Your display name and password.</p>
  </header>

  {
    savedMessage && (
      <p role="status" class="border-valid bg-valid/10 text-foreground rounded-md border px-3 py-2 text-sm">
        {savedMessage}
      </p>
    )
  }

  <AccountSettings email={email} displayName={displayName} isFirstPassword={pendingKind !== null} client:load />
</div>
