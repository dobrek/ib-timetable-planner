---
import AccountSettings from "./AccountSettings";

type Props = {
  email: string;
  displayName: string | null;
  /** `?saved=name` after a display-name save: the reload that shows the new name destroys its toast. */
  saved: string | null;
};

const { email, displayName, saved } = Astro.props;
---

<div class="max-w-xl space-y-6">
  <header>
    <h1 class="text-foreground text-2xl font-semibold tracking-tight">Account</h1>
    <p class="text-muted-foreground mt-1 text-sm">Your display name and password.</p>
  </header>

  {
    saved === "name" && (
      <p role="status" class="border-valid bg-valid/10 text-foreground rounded-md border px-3 py-2 text-sm">
        Display name saved.
      </p>
    )
  }

  <AccountSettings email={email} displayName={displayName} client:load />
</div>
