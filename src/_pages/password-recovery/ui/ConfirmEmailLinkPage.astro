---
import { buttonVariants } from "@/shared/ui";
import Banner from "@/shared/ui/Banner.astro";
import { type ConfirmPageState, confirmPageTitle, LINK_COPY } from "../model/confirm-page-state";

type Props = {
  /** What the query string holds: a link, an invitation the endpoint refused, or nothing usable. */
  state: ConfirmPageState;
  /** The email of a session this browser already holds, or `null`: spending the link replaces it. */
  signedInAs: string | null;
};

const { state, signedInAs } = Astro.props;

// The scanner-safe landing for an emailed one-time link. Rendering it spends nothing, on any HTTP
// method: a mail scanner can fetch it as often as it likes. Only a person pressing the native
// Continue button POSTs the token to `/api/auth/confirm`.
//
// Hard rules: no hydrated island, no script, no Turnstile or other third-party resource, no
// `meta refresh` — and no `href` anywhere on this page carries the token (a scanner follows links).
// The token travels only in the hidden fields below.
const linkClass = "text-muted-foreground hover:text-foreground text-sm underline underline-offset-4";
---

<div class="bg-background flex min-h-screen items-center justify-center p-4">
  <div
    class="border-border bg-card/80 text-card-foreground w-full max-w-sm space-y-6 rounded-2xl border p-8 shadow-lg backdrop-blur-xl"
  >
    <h1 class="text-center text-2xl font-bold">{confirmPageTitle(state)}</h1>

    {
      state.kind === "link" && (
        <>
          {signedInAs && (
            <div class="overflow-hidden rounded-lg">
              <Banner variant="warning">
                You're signed in as {signedInAs}. Continuing signs you in as the person this link was sent to.
              </Banner>
            </div>
          )}
          <p class="text-muted-foreground text-sm">{LINK_COPY[state.link.type].lead}</p>
          <form method="post" action="/api/auth/confirm">
            <input type="hidden" name="token_hash" value={state.link.tokenHash} />
            <input type="hidden" name="type" value={state.link.type} />
            <button type="submit" class:list={buttonVariants({ className: "w-full" })}>
              Continue
            </button>
          </form>
        </>
      )
    }

    {
      state.kind === "invite-failed" && state.reason === "expired" && (
        <>
          <div class="overflow-hidden rounded-lg">
            <Banner variant="warning">
              This invitation link has expired or was already used. Ask your admin to re-send it.
            </Banner>
          </div>
          <p class="text-center">
            <a href="/auth/signin" class:list={linkClass}>
              Already set your password? Sign in
            </a>
          </p>
        </>
      )
    }

    {
      state.kind === "invite-failed" && state.reason === "retry" && (
        <div class="overflow-hidden rounded-lg">
          <Banner variant="warning">
            We couldn't check your invitation just now. Open the link from your email again.
          </Banner>
        </div>
      )
    }

    {
      state.kind === "incomplete" && (
        <>
          <div class="overflow-hidden rounded-lg">
            <Banner variant="warning">This link is incomplete. Open it straight from the email.</Banner>
          </div>
          <p class="flex justify-center gap-4">
            <a href="/auth/signin" class:list={linkClass}>
              Sign in
            </a>
            <a href="/auth/forgot" class:list={linkClass}>
              Request a password reset
            </a>
          </p>
        </>
      )
    }
  </div>
</div>
