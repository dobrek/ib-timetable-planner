---
import { Input, Label, buttonVariants } from "@/shared/ui";
import Banner from "@/shared/ui/Banner.astro";
import type { ForgotAlert, ForgotPageState } from "../model/forgot-page-state";
import { LINK_LIFETIME, RESEND_INTERVAL } from "../model/recovery-policy";
import { TURNSTILE_ACTION } from "../model/turnstile-verdict";

type Props = {
  state: ForgotPageState;
  /** Rendered into the widget; present whenever `state` is the form (both keys configured). */
  siteKey: string;
};

const { state, siteKey } = Astro.props;

// Native form, no hydrated island: it works without JavaScript except for the Turnstile widget,
// which injects its `cf-turnstile-response` field into this form. The widget script loads only in
// the form state, so the sent and unavailable states load nothing from Cloudflare.
const ALERTS: Record<ForgotAlert, { variant: "warning" | "error"; text: string }> = {
  verification: {
    variant: "error",
    text: "We couldn't confirm this request. Wait until the check below the email field finishes, then send again.",
  },
  "link-expired": {
    variant: "warning",
    text: `This link has expired or was already used. Only the newest email works, for ${LINK_LIFETIME}. Request a new one below.`,
  },
  "link-invalid": {
    variant: "warning",
    text: "This link is incomplete. Open it straight from the email, or request a new one below.",
  },
  "link-retry": {
    variant: "warning",
    text: "We couldn't open your link just now. Go back to the email and open the link again in a minute.",
  },
};
const alert = state.kind === "form" && state.alert ? ALERTS[state.alert] : null;

const linkClass = "text-muted-foreground hover:text-foreground text-sm underline underline-offset-4";
---

<div class="bg-background flex min-h-screen items-center justify-center p-4">
  <div
    class="border-border bg-card/80 text-card-foreground w-full max-w-sm space-y-6 rounded-2xl border p-8 shadow-lg backdrop-blur-xl"
  >
    <h1 class="text-center text-2xl font-bold">Forgot password</h1>

    {
      state.kind === "form" && (
        <>
          {alert && (
            <div class="overflow-hidden rounded-lg">
              <Banner variant={alert.variant}>{alert.text}</Banner>
            </div>
          )}
          <p class="text-muted-foreground text-sm">
            Enter your email and we'll send you a link to choose a new password.
          </p>
          <form method="post" action="/api/auth/forgot" class="space-y-4">
            <div class="space-y-1">
              <Label htmlFor="email">Email</Label>
              <Input
                id="email"
                name="email"
                type="email"
                required
                autoComplete="username"
                placeholder="you@example.com"
              />
            </div>
            <div
              class="cf-turnstile"
              data-sitekey={siteKey}
              data-action={TURNSTILE_ACTION}
              data-theme="auto"
              data-size="flexible"
            />
            <button type="submit" class:list={buttonVariants({ className: "w-full" })}>
              Send reset link
            </button>
          </form>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
        </>
      )
    }

    {
      state.kind === "sent" && (
        <>
          <div class="overflow-hidden rounded-lg">
            <Banner variant="info">
              If an account exists for that address, we've sent a link. It works once, for {LINK_LIFETIME}. Only the
              newest email works. Didn't get it? Check Junk, then request again after {RESEND_INTERVAL}.
            </Banner>
          </div>
          <p class="text-center">
            <a href="/auth/forgot" class:list={linkClass}>
              Request another link
            </a>
          </p>
        </>
      )
    }

    {
      state.kind === "unavailable" && (
        <div class="overflow-hidden rounded-lg">
          <Banner variant="warning">
            Password reset is unavailable right now. Ask your coordinator to reset it for you.
          </Banner>
        </div>
      )
    }

    <p class="text-center">
      <a href="/auth/signin" class:list={linkClass}>Back to sign in</a>
    </p>
  </div>
</div>
