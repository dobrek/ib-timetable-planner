---
import CombinedPlannerBoard from "./CombinedPlannerBoard";
import type { PlannerBoardProps } from "../model/drag";

type Props = {
  planName: string;
  dp1: PlannerBoardProps;
  dp2: PlannerBoardProps;
  paletteCollapsed: boolean;
};

const { planName, dp1, dp2, paletteCollapsed } = Astro.props;
---

<div class="flex h-full min-h-0 flex-1 flex-col">
  <CombinedPlannerBoard planName={planName} dp1={dp1} dp2={dp2} paletteCollapsed={paletteCollapsed} client:load />
</div>
