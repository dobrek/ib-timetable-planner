---
import PlannerBoard from "./PlannerBoard";
import type { PlannerBoardProps, SharedBoardProps } from "../model/drag";
import type { BoardSurface } from "../lib/board-surface";

type Props = {
  planName: string;
  focus: BoardSurface;
  shared: SharedBoardProps;
  dp1: PlannerBoardProps;
  dp2: PlannerBoardProps;
  paletteCollapsed: boolean;
};

const { planName, focus, shared, dp1, dp2, paletteCollapsed } = Astro.props;
---

<div class="flex h-full min-h-0 flex-1 flex-col">
  <PlannerBoard
    planName={planName}
    focus={focus}
    shared={shared}
    dp1={dp1}
    dp2={dp2}
    paletteCollapsed={paletteCollapsed}
    client:load
  />
</div>
