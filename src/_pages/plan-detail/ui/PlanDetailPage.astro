---
import PlannerBoard from "./PlannerBoard";
import type { PlannerBoardProps, SharedBoardProps } from "../model/drag";
import type { Credit } from "@/entities/user";
import type { BatchExportSources } from "../lib/batch-export-workbooks";
import type { BoardSurface } from "../lib/board-surface";
import type { Cohort } from "@/shared/config";
import type { GenerationJobView } from "../api/generation-read";

type Props = {
  planName: string;
  /** The plan is the current one (S-404): the board heading carries the badge. */
  isCurrent: boolean;
  /** Who created the plan (S-407), resolved by the route; null when the lookup failed. */
  createdBy: Credit | null;
  focus: BoardSurface;
  shared: SharedBoardProps;
  dp1: PlannerBoardProps;
  dp2: PlannerBoardProps;
  batchExport: BatchExportSources;
  paletteCollapsed: boolean;
  initialPaletteCohort: Cohort;
  /** The plan's latest generation job, already read server-side (and, for an editor, delivered). */
  generationJob: GenerationJobView | null;
  /** The route's `allows(access, "edit")` (S-405). */
  canEdit: boolean;
};

const {
  planName,
  isCurrent,
  createdBy,
  focus,
  shared,
  dp1,
  dp2,
  batchExport,
  paletteCollapsed,
  initialPaletteCohort,
  generationJob,
  canEdit,
} = Astro.props;
---

<div class="flex h-full min-h-0 flex-1 flex-col">
  <PlannerBoard
    planName={planName}
    isCurrent={isCurrent}
    createdBy={createdBy}
    focus={focus}
    shared={shared}
    dp1={dp1}
    dp2={dp2}
    batchExport={batchExport}
    paletteCollapsed={paletteCollapsed}
    initialPaletteCohort={initialPaletteCohort}
    generationJob={generationJob}
    canEdit={canEdit}
    client:load
  />
</div>
