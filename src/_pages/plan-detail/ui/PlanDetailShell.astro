---
import Layout from "@/app/layouts/BaseLayout.astro";
import PlanDetailPage from "./PlanDetailPage.astro";
import PlanDetailError from "./PlanDetailError.astro";
import type { PlannerPageResult } from "../api/load";

type Props = { result: PlannerPageResult };
const { result } = Astro.props;
---

{
  result.ok ? (
    <Layout title={result.value.planName}>
      <PlanDetailPage planName={result.value.planName} boardProps={result.value.props} />
    </Layout>
  ) : (
    <Layout title={result.error.kind === "not-found" ? "Plan not found" : "Unavailable"}>
      <PlanDetailError
        kind={result.error.kind}
        message={result.error.kind === "unavailable" ? result.error.message : undefined}
      />
    </Layout>
  )
}
