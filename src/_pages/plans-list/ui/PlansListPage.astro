---
import type { PlanRow } from "@/_pages/plans-list/api";
import PlansHub from "./PlansHub";

type Props = {
  plans: PlanRow[] | null;
  /** The route's `allows(access, "edit")` (S-405). */
  canEdit: boolean;
};

const { plans, canEdit } = Astro.props;
---

{
  plans === null ? (
    <p class="text-muted-foreground text-sm">Plans are unavailable — Supabase is not configured.</p>
  ) : (
    <PlansHub plans={plans} canEdit={canEdit} client:load />
  )
}
