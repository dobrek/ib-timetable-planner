---
import type { PlanRow } from "@/_pages/plans-list/api";
import PlansHub from "./PlansHub";

type Props = {
  plans: PlanRow[] | null;
};

const { plans } = Astro.props;
---

{
  plans === null ? (
    <p class="text-muted-foreground text-sm">Plans are unavailable — Supabase is not configured.</p>
  ) : (
    <PlansHub plans={plans} client:load />
  )
}
