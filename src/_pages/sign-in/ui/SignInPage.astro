---
import SignInForm from "./SignInForm";

type Props = {
  serverError: string | null;
};

const { serverError } = Astro.props;
---

<div class="bg-background flex min-h-screen items-center justify-center p-4">
  <div
    class="border-border bg-card/80 text-card-foreground w-full max-w-sm rounded-2xl border p-8 shadow-lg backdrop-blur-xl"
  >
    <h1 class="mb-6 text-center text-2xl font-bold">Sign in</h1>
    <SignInForm serverError={serverError} client:load />
  </div>
</div>
