---
import "@/app/styles/global.css";
import Banner from "@/shared/ui/Banner.astro";
import { missingConfigs } from "@/app/config/config-status";

type Props = {
  title?: string;
};

const { title = "10x Astro Starter" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Apply the persisted (or system) theme before first paint to avoid a flash.
      const theme = localStorage.getItem("theme");
      if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    {
      /* Wrap in a print-hidden container: `class` on <Banner> would be a silent no-op
       (Banner.astro accepts only `variant` and Astro doesn't auto-forward class to a
       component root), so the print:hidden lives on this wrapper. */
    }
    <div class="print:hidden">
      {
        missingConfigs.map((cfg) => (
          <Banner variant="error">
            <strong>Uwaga:</strong> {cfg.message}
            {cfg.docsUrl && (
              <>
                {" "}
                <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                  {cfg.docsLabel ?? "Dokumentacja"}
                </a>
                .
              </>
            )}
          </Banner>
        ))
      }
    </div>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* The `height: 100%` clamp above pins content to one viewport — under print it would
     print only the first page. Reset to auto so content flows onto paper. This reset lives
     here (not in global.css) because the clamp is a scoped rule; Astro scopes it with a
     `[data-astro-cid-*]` attribute (specificity 0,1,1) that a plain `html, body` rule in
     global.css (0,0,1) would lose to. Same scope → the print reset wins. */
  @media print {
    html,
    body {
      height: auto;
    }
  }
</style>
