---
import "@/app/styles/global.css";
import Banner from "@/shared/ui/Banner.astro";
import { missingConfigs } from "@/shared/lib";

type Props = {
  title?: string;
};

const { title = "10x Astro Starter" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      // Apply the persisted (or system) theme before first paint to avoid a flash.
      const theme = localStorage.getItem("theme");
      if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
    <script is:inline>
      // Apply the sidebar collapse state before first paint to avoid a width flash.
      // Below lg the rail always starts collapsed; otherwise the stored preference
      // wins, and with none the board route defaults to collapsed. Evaluated at load
      // only — every MPA navigation re-runs it, so no resize listener is needed.
      let storedCollapse = null;
      try {
        storedCollapse = localStorage.getItem("sidebar-collapsed");
      } catch {
        // Storage blocked — treat as no preference so the viewport/route defaults apply.
      }
      if (
        !window.matchMedia("(min-width: 1024px)").matches ||
        (storedCollapse !== null ? storedCollapse === "true" : /^\/plans\/[^/]+$/.test(location.pathname))
      ) {
        document.documentElement.classList.add("sidebar-collapsed");
      }
    </script>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
