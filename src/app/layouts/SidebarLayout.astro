---
import BaseLayout from "./BaseLayout.astro";
import SidebarNavLink from "./SidebarNavLink.astro";
import { GLOBAL_NAV_ITEMS, planNavItems, type NavItem } from "@/shared/config";
import { Sun, Moon, PanelLeft, LogOut } from "lucide-react";

type Props = {
  title?: string;
  /** When set, the sidebar renders the plan's scenario-local sub-nav + breadcrumb. */
  plan?: { id: string; name: string };
  /** Full-bleed content mode: no centered max-w wrapper, no breadcrumb (e.g. the planner board). */
  fullWidth?: boolean;
};

const { title, plan, fullWidth = false } = Astro.props;
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

// Home and the plan board match exactly (the board href prefixes every plan sub-route);
// other sections match on prefix so /plans/[id]/courses still highlights "Courses" and
// /plans (the hub) highlights "Plans".
const EXACT_HREFS = new Set(["/dashboard", ...(plan ? [`/plans/${plan.id}`] : [])]);
const isActive = (href: string) =>
  EXACT_HREFS.has(href) ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);

const withActive = (item: NavItem) => ({ ...item, active: isActive(item.href) });
const globalItems = GLOBAL_NAV_ITEMS.map(withActive);
const planItems = plan ? planNavItems(plan.id).map(withActive) : [];

const iconButtonClass =
  "text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md transition-colors";
---

<BaseLayout title={title}>
  <script is:inline>
    // Runs during parse, before the aside below exists, so the rail renders at the
    // correct width on first paint. Below lg it always starts collapsed; otherwise
    // the stored preference wins, and with none the board route defaults to
    // collapsed. Re-evaluated on every MPA navigation — no resize listener needed.
    let storedCollapse = null;
    try {
      storedCollapse = localStorage.getItem("sidebar-collapsed");
    } catch {
      // Storage blocked — treat as no preference so the viewport/route defaults apply.
    }
    if (
      !window.matchMedia("(min-width: 1024px)").matches ||
      (storedCollapse !== null ? storedCollapse === "true" : /^\/plans\/[^/]+$/.test(location.pathname))
    ) {
      document.documentElement.classList.add("sidebar-collapsed");
    }
  </script>
  <div class="bg-background text-foreground flex h-screen">
    <aside
      id="app-sidebar"
      class="border-sidebar-border bg-sidebar text-sidebar-foreground collapsed:w-16 flex w-60 shrink-0 flex-col overflow-hidden border-r transition-[width] duration-200 motion-reduce:transition-none"
    >
      <div
        class="border-sidebar-border collapsed:justify-center collapsed:px-0 flex items-center justify-between gap-2 border-b px-5 py-3"
      >
        <a
          href="/dashboard"
          class="collapsed:hidden overflow-hidden text-base font-semibold tracking-tight whitespace-nowrap"
        >
          Timetable Planner
        </a>
        <button
          type="button"
          id="sidebar-toggle"
          aria-label="Toggle sidebar"
          aria-expanded="true"
          aria-controls="app-sidebar"
          title="Collapse sidebar (⌘B)"
          class:list={iconButtonClass}
        >
          <PanelLeft size={16} aria-hidden="true" />
        </button>
      </div>

      <nav class="flex-1 space-y-1 overflow-y-auto p-3" aria-label="Primary">
        {globalItems.map((item) => <SidebarNavLink {...item} />)}

        {
          plan && (
            <div class="collapsed:border-t collapsed:border-sidebar-border pt-4">
              <p
                class="text-sidebar-foreground/60 collapsed:hidden truncate px-3 pb-1 text-xs font-medium tracking-wide uppercase"
                title={plan.name}
              >
                {plan.name}
              </p>
              <div class="space-y-1" role="group" aria-label={`Plan: ${plan.name}`}>
                {planItems.map((item) => (
                  <SidebarNavLink {...item} />
                ))}
              </div>
            </div>
          )
        }
      </nav>

      <div class="border-sidebar-border border-t p-3">
        <div class="collapsed:justify-center collapsed:px-0 flex items-center justify-between gap-2 px-3 pb-2">
          <p class="text-sidebar-foreground/70 collapsed:hidden truncate text-xs" title={user?.email}>
            {user?.email}
          </p>
          <button type="button" id="theme-toggle" aria-label="Toggle theme" class:list={iconButtonClass}>
            <span class="dark:hidden"><Moon size={16} aria-hidden="true" /></span>
            <span class="hidden dark:block"><Sun size={16} aria-hidden="true" /></span>
          </button>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            title="Sign out"
            class="border-sidebar-border text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground collapsed:px-0 flex w-full cursor-pointer items-center justify-center gap-2 rounded-md border px-3 py-2 text-sm font-medium transition-colors"
          >
            <LogOut size={16} aria-hidden="true" />
            <span class="collapsed:hidden overflow-hidden whitespace-nowrap">Sign out</span>
          </button>
        </form>
      </div>
    </aside>

    {
      fullWidth ? (
        <main class="flex min-w-0 flex-1 flex-col overflow-hidden">
          <slot />
        </main>
      ) : (
        <main class="flex-1 overflow-y-auto">
          <div class="mx-auto max-w-5xl px-8 py-10">
            {plan && (
              <nav class="text-muted-foreground mb-6 flex items-center gap-1.5 text-sm" aria-label="Breadcrumb">
                <a href="/plans" class="hover:text-foreground transition-colors">
                  Plans
                </a>
                <span aria-hidden="true">/</span>
                <span class="text-foreground font-medium">{plan.name}</span>
              </nav>
            )}
            <slot />
          </div>
        </main>
      )
    }
  </div>
</BaseLayout>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  const sidebarToggle = document.getElementById("sidebar-toggle");
  const shortcutHint = /Mac|iP/.test(navigator.platform) ? "⌘B" : "Ctrl+B";

  const syncSidebarToggle = () => {
    const collapsed = document.documentElement.classList.contains("sidebar-collapsed");
    sidebarToggle?.setAttribute("aria-expanded", String(!collapsed));
    sidebarToggle?.setAttribute("title", `${collapsed ? "Expand" : "Collapse"} sidebar (${shortcutHint})`);
  };

  const toggleSidebar = () => {
    const collapsed = document.documentElement.classList.toggle("sidebar-collapsed");
    syncSidebarToggle();
    // Below lg the toggle only peeks the sidebar open for this page view —
    // persisting would overwrite the user's desktop preference.
    if (window.matchMedia("(min-width: 1024px)").matches) {
      localStorage.setItem("sidebar-collapsed", String(collapsed));
    }
  };

  sidebarToggle?.addEventListener("click", toggleSidebar);
  document.addEventListener("keydown", (event) => {
    if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "b") return;
    if (event.shiftKey || event.altKey) return;
    if (event.target instanceof Element && event.target.closest("input, textarea, select, [contenteditable]")) return;
    event.preventDefault();
    toggleSidebar();
  });

  syncSidebarToggle();
</script>
