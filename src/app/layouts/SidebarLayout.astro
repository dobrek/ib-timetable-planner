---
import BaseLayout from "./BaseLayout.astro";
import { GLOBAL_NAV_ITEMS, planNavItems, type NavItem } from "@/shared/config";
import { Sun, Moon } from "lucide-react";

type Props = {
  title?: string;
  /** When set, the sidebar renders the plan's scenario-local sub-nav + breadcrumb. */
  plan?: { id: string; name: string };
};

const { title, plan } = Astro.props;
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

// Home and the plan board match exactly (the board href prefixes every plan sub-route);
// other sections match on prefix so /plans/[id]/courses still highlights "Courses" and
// /plans (the hub) highlights "Plans".
const EXACT_HREFS = new Set(["/dashboard", ...(plan ? [`/plans/${plan.id}`] : [])]);
const isActive = (href: string) =>
  EXACT_HREFS.has(href) ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);

const renderItem = (item: NavItem) => ({ ...item, active: isActive(item.href) });
const globalItems = GLOBAL_NAV_ITEMS.map(renderItem);
const planItems = plan ? planNavItems(plan.id).map(renderItem) : [];
---

<BaseLayout title={title}>
  <div class="bg-background text-foreground flex h-screen">
    <aside class="border-sidebar-border bg-sidebar text-sidebar-foreground flex w-60 shrink-0 flex-col border-r">
      <div class="border-sidebar-border border-b px-5 py-4">
        <a href="/dashboard" class="text-base font-semibold tracking-tight">Timetable Planner</a>
      </div>

      <nav class="flex-1 space-y-1 overflow-y-auto p-3" aria-label="Primary">
        {
          globalItems.map((item) => {
            const Icon = item.icon;
            return (
              <a
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class:list={[
                  "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors",
                  item.active
                    ? "bg-sidebar-accent text-sidebar-accent-foreground"
                    : "text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground",
                ]}
              >
                <Icon size={18} aria-hidden="true" />
                <span>{item.label}</span>
              </a>
            );
          })
        }

        {
          plan && (
            <div class="pt-4">
              <p
                class="text-sidebar-foreground/60 truncate px-3 pb-1 text-xs font-medium tracking-wide uppercase"
                title={plan.name}
              >
                {plan.name}
              </p>
              <div class="space-y-1" role="group" aria-label={`Plan: ${plan.name}`}>
                {planItems.map((item) => {
                  const Icon = item.icon;
                  return (
                    <a
                      href={item.href}
                      aria-current={item.active ? "page" : undefined}
                      class:list={[
                        "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors",
                        item.active
                          ? "bg-sidebar-accent text-sidebar-accent-foreground"
                          : "text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground",
                      ]}
                    >
                      <Icon size={18} aria-hidden="true" />
                      <span>{item.label}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          )
        }
      </nav>

      <div class="border-sidebar-border border-t p-3">
        <div class="flex items-center justify-between gap-2 px-3 pb-2">
          <p class="text-sidebar-foreground/70 truncate text-xs" title={user?.email}>
            {user?.email}
          </p>
          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle theme"
            class="text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md transition-colors"
          >
            <span class="dark:hidden"><Moon size={16} aria-hidden="true" /></span>
            <span class="hidden dark:block"><Sun size={16} aria-hidden="true" /></span>
          </button>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="border-sidebar-border text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground w-full cursor-pointer rounded-md border px-3 py-2 text-sm font-medium transition-colors"
          >
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <main class="flex-1 overflow-y-auto">
      <div class="mx-auto max-w-5xl px-8 py-10">
        {
          plan && (
            <nav class="text-muted-foreground mb-6 flex items-center gap-1.5 text-sm" aria-label="Breadcrumb">
              <a href="/plans" class="hover:text-foreground transition-colors">
                Plans
              </a>
              <span aria-hidden="true">/</span>
              <span class="text-foreground font-medium">{plan.name}</span>
            </nav>
          )
        }
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
