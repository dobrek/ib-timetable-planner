---
import Layout from "@/app/layouts/BaseLayout.astro";
import ConfirmEmailLinkPage from "@/_pages/password-recovery/ui/ConfirmEmailLinkPage.astro";
import { confirmPageState, confirmPageTitle } from "@/_pages/password-recovery";

// Public (middleware allowlist): the link holder is signed out until they press Continue (S-402).
// This page renders on EVERY method — Astro renders an .astro page for POST too — so it has no side
// effects at all; only `POST /api/auth/confirm` spends a link.
//
// Response headers take effect only here, in the route file (Astro ignores them in a component):
// - `no-store`: the page holds a one-time token, and may name the signed-in user.
// - `strict-origin`, never `no-referrer`: under `no-referrer` Chromium sends `Origin: null` on the
//   Continue POST, and Astro's origin check answers it with 403. `strict-origin` still keeps the
//   token-carrying path and query out of every Referer.
// - `noindex`: a confirm URL is never a search result.
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "strict-origin");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const state = confirmPageState(Astro.url.searchParams);
// The middleware reads the session on public routes too. Spending a link replaces it, so a person
// already signed in is warned before Continue switches them to whoever the link was sent to (S-410).
const signedInAs = Astro.locals.user?.email ?? null;
---

<Layout title={confirmPageTitle(state)}>
  <ConfirmEmailLinkPage state={state} signedInAs={signedInAs} />
</Layout>
