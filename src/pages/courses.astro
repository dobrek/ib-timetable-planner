---
import AppShellLayout from "@/layouts/AppShellLayout.astro";
import CourseCatalog from "@/components/courses/CourseCatalog";
import { createClient } from "@/lib/supabase";
import type { CohortTab, CourseRow, TeacherOption } from "@/components/courses/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

type CatalogData = {
  cohorts: CohortTab[];
  courses: CourseRow[];
  teachers: TeacherOption[];
};

// Cohort order is naive (alphabetical name → first = Year 1). Stable for the two seed
// names; the future cohort-CRUD slice replaces it with an explicit ordinal (see plan).
const cohortLabel = (index: number) => `Year ${index + 1}`;

const fetchCatalog = async (client: NonNullable<typeof supabase>): Promise<CatalogData> => {
  const [cohortsRes, coursesRes, teachersRes, mergesRes] = await Promise.all([
    client.from("cohorts").select("id, name").order("name"),
    client
      .from("courses")
      .select("id, cohort_id, name, level, group_index, hours_per_week, teacher_id")
      .order("group_index")
      .order("name")
      .limit(500),
    client.from("teachers").select("id, code, full_name").order("code").limit(500),
    client.from("course_merges").select("parent_course_id"),
  ]);

  for (const res of [cohortsRes, coursesRes, teachersRes, mergesRes]) {
    if (res.error) throw new Error(`Catalog lookup failed: ${res.error.message}`);
  }

  const teacherLabel = new Map((teachersRes.data ?? []).map((t) => [t.id, t.full_name ?? t.code] as const));

  // Only the composite merge *parent* (the virtual combined session, e.g. "German B AB+SL")
  // renders read-only. Its atomic children (German B AB, German B SL) stay editable courses.
  const mergeParentIds = new Set<string>();
  for (const m of mergesRes.data ?? []) {
    mergeParentIds.add(m.parent_course_id);
  }

  return {
    cohorts: (cohortsRes.data ?? []).map((c, index) => ({ id: c.id, label: cohortLabel(index) })),
    courses: (coursesRes.data ?? []).map((c) => ({
      id: c.id,
      cohortId: c.cohort_id,
      name: c.name,
      level: c.level,
      groupIndex: c.group_index,
      hours: c.hours_per_week,
      teacherId: c.teacher_id,
      teacherLabel: c.teacher_id ? (teacherLabel.get(c.teacher_id) ?? null) : null,
      isMerged: mergeParentIds.has(c.id),
    })),
    teachers: (teachersRes.data ?? []).map((t) => ({ id: t.id, label: t.full_name ?? t.code })),
  };
};

// null = Supabase unavailable; otherwise the projected catalog (possibly empty).
const catalog = supabase ? await fetchCatalog(supabase) : null;
if (!catalog) Astro.response.status = 503;
---

<AppShellLayout title="Courses">
  {
    catalog === null ? (
      <p class="text-muted-foreground text-sm">Courses are unavailable — Supabase is not configured.</p>
    ) : catalog.cohorts.length === 0 ? (
      <p class="text-muted-foreground text-sm">No cohorts yet — seed the database to manage courses.</p>
    ) : (
      <CourseCatalog cohorts={catalog.cohorts} courses={catalog.courses} teachers={catalog.teachers} client:load />
    )
  }
</AppShellLayout>
