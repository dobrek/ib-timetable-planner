---
import PlanDetailShell from "@/_pages/plan-detail/ui/PlanDetailShell.astro";
import { createClient } from "@/shared/api";
import { loadPlannerData, type PlannerPageResult } from "@/_pages/plan-detail/api";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result: PlannerPageResult = supabase
  ? await loadPlannerData(supabase, Astro.params.id)
  : { kind: "unavailable", message: "Supabase is not configured" };
if (result.kind === "not-found") Astro.response.status = 404;
else if (result.kind === "unavailable") Astro.response.status = 503;
---

<PlanDetailShell result={result} />
