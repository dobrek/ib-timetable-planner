---
import AppShellLayout from "@/app/layouts/SidebarLayout.astro";
import PlanScopedError from "@/app/layouts/PlanScopedError.astro";
import CourseCatalog from "@/_pages/courses/ui/CourseCatalog";
import { createClient, isPlanId, loadPlanSummary } from "@/shared/api";
import { loadCatalog } from "@/_pages/courses/api";

const supabase = createClient(Astro.request.headers, Astro.cookies);
// The catalog load only needs the route param, so it runs alongside the plan
// lookup; the isPlanId guard keeps malformed ids on the 404 path (a raw
// non-UUID would make the catalog query itself error → 500).
const planId = isPlanId(Astro.params.id) ? Astro.params.id : undefined;
const [plan, result] =
  supabase && planId
    ? await Promise.all([loadPlanSummary(supabase, planId), loadCatalog(supabase, planId)])
    : [null, null];
if (!supabase) Astro.response.status = 503;
else if (!plan) Astro.response.status = 404;

const catalog = result?.ok ? result.value : null;
---

<AppShellLayout title={plan ? `${plan.name} — Courses` : "Courses"} plan={plan ?? undefined}>
  {
    !supabase ? (
      <p class="text-muted-foreground text-sm">Courses are unavailable — Supabase is not configured.</p>
    ) : !plan ? (
      <PlanScopedError />
    ) : catalog === null ? (
      <p class="text-muted-foreground text-sm">Courses are unavailable — Supabase is not configured.</p>
    ) : (
      <CourseCatalog planId={plan.id} courses={catalog.courses} teachers={catalog.teachers} client:load />
    )
  }
</AppShellLayout>
