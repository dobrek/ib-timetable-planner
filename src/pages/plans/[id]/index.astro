---
import SidebarLayout from "@/app/layouts/SidebarLayout.astro";
import PlanDetailPage from "@/_pages/plan-detail/ui/PlanDetailPage.astro";
import PlanDetailError from "@/_pages/plan-detail/ui/PlanDetailError.astro";
import { createClient } from "@/shared/api";
import { loadCombinedPlannerData } from "@/_pages/plan-detail/api";
import { boardSurfaceSchema } from "@/_pages/plan-detail/lib/board-surface";
import { COOKIE_NAME, parsePaletteCollapsed } from "@/_pages/plan-detail/lib/palette-collapsed";
import { COOKIE_NAME as PALETTE_COHORT_COOKIE, parsePaletteCohort } from "@/_pages/plan-detail/lib/palette-cohort";

const supabase = createClient(Astro.request.headers, Astro.cookies);
// `?focus=` selects the surface — dp1 / dp2 / combined; missing/garbage coerces to combined (the
// default landing — "combined is the board"). Both cohorts always load (one loader for every mode).
const focus = boardSurfaceSchema.parse(Astro.url.searchParams.get("focus"));
const result = await loadCombinedPlannerData(supabase, Astro.params.id);
if (!result.ok) Astro.response.status = result.error.kind === "not-found" ? 404 : 503;

// Read the per-device palette-collapse pref server-side so the island can seed flash-free
// initial state (a client-only read would render expanded for one frame then snap shut).
const paletteCollapsed = parsePaletteCollapsed(Astro.cookies.get(COOKIE_NAME)?.value);
// Same rationale for the combined-mode palette cohort: seeding from the cookie keeps the selection
// across the full-document refresh a stale-grouping recompute triggers (else it snaps back to dp1).
const initialPaletteCohort = parsePaletteCohort(Astro.cookies.get(PALETTE_COHORT_COOKIE)?.value);
---

{
  result.ok ? (
    <SidebarLayout
      title={result.value.planName}
      plan={{ id: result.value.shared.planId, name: result.value.planName }}
      fullWidth
    >
      <PlanDetailPage
        planName={result.value.planName}
        focus={focus}
        shared={result.value.shared}
        dp1={result.value.dp1}
        dp2={result.value.dp2}
        batchExport={result.value.batchExport}
        paletteCollapsed={paletteCollapsed}
        initialPaletteCohort={initialPaletteCohort}
      />
    </SidebarLayout>
  ) : (
    <SidebarLayout title={result.error.kind === "not-found" ? "Plan not found" : "Unavailable"}>
      <PlanDetailError
        kind={result.error.kind}
        message={result.error.kind === "unavailable" ? result.error.message : undefined}
      />
    </SidebarLayout>
  )
}
