---
import AppShellLayout from "@/app/layouts/SidebarLayout.astro";
import PlanScopedError from "@/app/layouts/PlanScopedError.astro";
import TeacherCatalog from "@/_pages/teachers/ui/TeacherCatalog";
import { createClient, isPlanId, loadPlanSummary } from "@/shared/api";
import { parseGridPreset } from "@/shared/lib/grid";
import { loadTeacherCatalog } from "@/_pages/teachers/api";

const supabase = createClient(Astro.request.headers, Astro.cookies);
// The catalog load only needs the route param, so it runs alongside the plan
// lookup; the isPlanId guard keeps malformed ids on the 404 path (a raw
// non-UUID would make the catalog query itself error → 500).
const planId = isPlanId(Astro.params.id) ? Astro.params.id : undefined;
const [plan, result] =
  supabase && planId
    ? await Promise.all([loadPlanSummary(supabase, planId), loadTeacherCatalog(supabase, planId)])
    : [null, null];
if (!supabase) Astro.response.status = 503;
else if (!plan) Astro.response.status = 404;

const catalog = result?.ok ? result.value : null;
// Size the availability authoring grid to the plan's actual grid (falls back safely on null).
const { days, periods } = parseGridPreset(plan?.slot_grid_preset);
---

<AppShellLayout title={plan ? `${plan.name} — Teachers` : "Teachers"} plan={plan ?? undefined}>
  {
    !supabase ? (
      <p class="text-muted-foreground text-sm">Teachers are unavailable — Supabase is not configured.</p>
    ) : !plan ? (
      <PlanScopedError />
    ) : catalog === null ? (
      <p class="text-muted-foreground text-sm">Teachers are unavailable — Supabase is not configured.</p>
    ) : (
      <TeacherCatalog planId={plan.id} teachers={catalog.teachers} days={days} periods={periods} client:load />
    )
  }
</AppShellLayout>
