---
import AppShellLayout from "@/app/layouts/SidebarLayout.astro";
import PlanScopedError from "@/app/layouts/PlanScopedError.astro";
import TeacherPlanPage from "@/_pages/teacher-plan-view/ui/TeacherPlanPage";
import { createClient, isPlanId, loadPlanSummary } from "@/shared/api";
import { loadTeacherPlanView } from "@/_pages/teacher-plan-view/api";

const supabase = createClient(Astro.request.headers, Astro.cookies);
// Both params are guarded inside the loader (UUID checks → not-found), but the plan
// summary lookup still wants a well-formed id for the sidebar context.
const planId = isPlanId(Astro.params.id) ? Astro.params.id : undefined;
const teacherId = Astro.params.teacherId;
const [plan, result] =
  supabase && planId && teacherId
    ? await Promise.all([loadPlanSummary(supabase, planId), loadTeacherPlanView(supabase, planId, teacherId)])
    : [null, null];

if (!supabase) Astro.response.status = 503;
else if (!plan) Astro.response.status = 404;
// "unavailable" → 503 is defensive-only here: the loader returns it solely for a null
// client, and this route only calls it when `supabase` is non-null.
else if (!result.ok) Astro.response.status = result.error.kind === "not-found" ? 404 : 503;

const data = result?.ok && plan ? result.value : null;
const title = data ? `${data.planName} — ${data.teacher.fullName ?? data.teacher.code}` : "Teacher schedule";
---

<AppShellLayout title={title} plan={plan ?? undefined}>
  {
    !supabase || (result && !result.ok && result.error.kind === "unavailable") ? (
      <p class="text-muted-foreground text-sm">The teacher schedule is unavailable — Supabase is not configured.</p>
    ) : data === null ? (
      <PlanScopedError />
    ) : (
      <TeacherPlanPage data={data} client:load />
    )
  }
</AppShellLayout>
