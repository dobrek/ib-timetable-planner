---
import AppShellLayout from "@/app/layouts/SidebarLayout.astro";
import PlanScopedError from "@/app/layouts/PlanScopedError.astro";
import PlanComparisonPage from "@/_pages/plan-comparison/ui/PlanComparisonPage";
// By direct path, not through the `api` barrel: that barrel is `bench/`'s contract and is kept
// React-free, while this module reaches `analyzePlan` through the entity barrel (which re-exports a
// React component). Same Astro FSD exception the component import above uses.
import { loadComparison } from "@/_pages/plan-comparison/api/load-comparison";
import { readCompareParams } from "@/_pages/plan-comparison/lib/compare-params";
import { createClient } from "@/shared/api";

// The selection lives in the URL and is read SERVER-side: it selects the SSR dataset, so it must be
// parsed before the loader runs. (The `plans/[id]/index.astro` precedent, not the client-side
// `useUrlSyncedFilters` one.) The author picks the plans on the hub; this page only reports on the ones
// the URL names. Middleware auto-gates this route — deny-by-default, no allowlist change.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { planIds, omittedForCap } = readCompareParams(Astro.url.search);

const comparison = supabase && planIds.length > 0 ? await loadComparison(supabase, planIds) : null;

// An empty selection is an empty state, not an error — only a selection where NOT ONE plan resolved is a
// 404. One survivor still has something to show, so the page renders it and names the rest rather than
// 404-ing a page that has content.
if (!supabase) Astro.response.status = 503;
else if (comparison !== null && comparison.data === null) Astro.response.status = 404;

const data = comparison?.data ?? null;
const notFound = comparison !== null && comparison.data === null;
---

<AppShellLayout title="Compare plans">
  {
    /*
     * Hydrated only for the metric-help popovers — the one interactive thing on the page.
     *
     * This does NOT reopen the picker problem. That bug was client state *selecting the data*: the
     * in-page picker could be changed while the SSR'd columns kept their old values, so the page could
     * show one selection and a different selection's numbers. The selection now arrives in the URL and
     * every figure below is a pure function of the SSR load; a popover's open/closed state cannot reach
     * them. If anything on this page ever again holds state that *chooses what is measured*, it belongs
     * on the hub, not here.
     */
  }
  {
    !supabase ? (
      <p class="text-muted-foreground text-sm">Plan comparison is unavailable — Supabase is not configured.</p>
    ) : notFound ? (
      <PlanScopedError />
    ) : (
      <PlanComparisonPage data={data} omittedForCap={omittedForCap} client:load />
    )
  }
</AppShellLayout>
