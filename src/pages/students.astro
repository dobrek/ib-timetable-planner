---
import AppShellLayout from "@/app/layouts/SidebarLayout.astro";
import StudentCatalog from "@/_pages/students/ui/StudentCatalog";
import { createClient } from "@/shared/api";
import { loadStudentCatalog } from "@/_pages/students/api";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = await loadStudentCatalog(supabase);
if (!result.ok) Astro.response.status = 503;
const catalog = result.ok ? result.value : null;
---

<AppShellLayout title="Students">
  {
    catalog === null ? (
      <p class="text-muted-foreground text-sm">Students are unavailable — Supabase is not configured.</p>
    ) : catalog.cohorts.length === 0 ? (
      <p class="text-muted-foreground text-sm">No cohorts yet — seed the database to manage students.</p>
    ) : (
      <StudentCatalog students={catalog.students} cohorts={catalog.cohorts} courses={catalog.courses} client:load />
    )
  }
</AppShellLayout>
