---
import AppShellLayout from "@/app/layouts/SidebarLayout.astro";
import TeacherCatalog from "@/_pages/teachers/ui/TeacherCatalog";
import { createClient } from "@/shared/api";
import { loadTeacherCatalog } from "@/_pages/teachers/api";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = await loadTeacherCatalog(supabase);
if (result.kind === "unavailable") Astro.response.status = 503;
const catalog = result.kind === "ok" ? result.data : null;
---

<AppShellLayout title="Teachers">
  {
    catalog === null ? (
      <p class="text-muted-foreground text-sm">Teachers are unavailable — Supabase is not configured.</p>
    ) : catalog.cohortIds.y1 === "" ? (
      <p class="text-muted-foreground text-sm">No cohorts yet — seed the database to manage teachers.</p>
    ) : (
      <TeacherCatalog teachers={catalog.teachers} cohortIds={catalog.cohortIds} client:load />
    )
  }
</AppShellLayout>
