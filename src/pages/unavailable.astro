---
import BaseLayout from "@/app/layouts/BaseLayout.astro";

// The middleware renders this through `next("/unavailable")` when the role lookup fails (S-403): the
// browser keeps its URL, and the user is never told they lack access because of a blip. It reads no
// plan data, so it stands outside the app shell, which would read the profile again.
Astro.response.status = 503;
---

<BaseLayout title="Temporarily unavailable">
  <main class="bg-background text-foreground flex min-h-full items-center justify-center px-4">
    <div class="max-w-md py-16 text-center">
      <h1 class="text-2xl font-semibold tracking-tight">We couldn't check your access</h1>
      <p class="text-muted-foreground mt-2 text-sm">
        Something went wrong on our side. Reload the page in a moment to try again.
      </p>
    </div>
  </main>
</BaseLayout>
