---
type Variant = "info" | "warning" | "error";

type Props = {
  variant?: Variant;
};

const { variant = "info" } = Astro.props;

// Semantic tokens only (lessons.md), so the banner follows light/dark from global.css.
const VARIANT_CLASSES: Record<Variant, string> = {
  info: "border-border bg-accent text-accent-foreground",
  warning: "border-warning bg-warning/15 text-foreground",
  error: "border-destructive bg-destructive/10 text-destructive",
};
---

<div
  class:list={[
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:text-inherit [&_a]:underline",
    VARIANT_CLASSES[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
